---
import { userData } from '@/lib/user-data';

const commitHash = import.meta.env.CF_PAGES_COMMIT_SHA?.slice(0, 7) ?? 'unknown';

const repoUrl = userData.social.github.url;
---

<footer class="flex flex-col items-center w-full py-16 px-6 gap-10 bg-background text-foreground text-center">
  <div class="text-7xl md:text-8xl font-serif tracking-wide select-none">
    {userData.name}
  </div>

  <div class="flex flex-wrap w-full max-w-2xl items-start justify-around gap-8 text-2xl font-sans font-light lowercase">
    <div class="flex flex-col gap-1">
      <a href="/about" class="text-muted-foreground hover:text-foreground transition-colors">about</a>
      <a href="/guestbook" class="text-muted-foreground hover:text-foreground transition-colors">guestbook</a>
    </div>
    <div class="flex flex-col gap-1">
      <a href="/projects" class="text-muted-foreground hover:text-foreground transition-colors">projects</a>
      <a href="/blog" class="text-muted-foreground hover:text-foreground transition-colors">blog</a>
    </div>
    <div class="flex flex-col gap-1">
      <a href={userData.social.github.url} target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors">github</a>
      <a href="/contact" class="text-muted-foreground hover:text-foreground transition-colors">contact</a>
    </div>
    <div class="flex flex-col gap-1">
      <a href="/colophon" class="text-muted-foreground hover:text-foreground transition-colors">colophon</a>
      <a href="/webrings" class="text-muted-foreground hover:text-foreground transition-colors">webrings</a>
    </div>
  </div>

  <div class="text-sm font-serif tracking-wider text-muted-foreground">
        commit <a href={`${repoUrl}/commit/${commitHash}`} target="_blank" rel="noopener noreferrer" class="text-foreground hover:text-muted-foreground hover:underline underline-offset-4">{commitHash}</a>  </div>
  <!-- integrate the github current commit pulling later -->
</footer>