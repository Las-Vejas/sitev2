---
import Layout from '@/layouts/main.astro';
import { GuestbookForm } from '@/components/GuestbookForm';
import GuestbookCards from '@/components/GuestbookCards';
---

<Layout>
  <div class="min-h-screen antialiased font-sans flex flex-col justify-between">
    <main class="w-full mx-auto px-6 py-16 flex-1 text-center">
      <h1 class="text-6xl font-serif tracking-tight mb-3">Guestbook</h1>
      <p class="text-neutral-400 text-sm max-w-md mx-auto font-sans mb-12">
        Feel free to leave any messages or thoughts about my site!
      </p>

      <div class="grid gap-6 p-4 grid-cols-[repeat(auto-fit,minmax(400px,1fr))]">
        <GuestbookForm client:load />
        <GuestbookCards client:load />
      </div>
    </main>
  </div>
</Layout>

