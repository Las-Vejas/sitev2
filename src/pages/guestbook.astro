---
import Layout from '@/layouts/main.astro';
import { ChevronLeft, ChevronRight, Send } from 'lucide-react';
---

<Layout>
  <div class="min-h-screen antialiased font-sans flex flex-col justify-between">
    <main class="w-full mx-auto px-6 py-16 flex-1 text-center">
      <h1 class="text-6xl font-serif tracking-tight mb-3">Guestbook</h1>
      <p class="text-neutral-400 text-sm max-w-md mx-auto font-sans mb-16">
        Feel free to leave any messages or thoughts about my site!
      </p>

      <div class="grid grid-cols-5 grid-rows-4 gap-3">
        <form id="guestbook-form">
          <input type="text" name="name" required />
          <textarea name="message" required></textarea>
          <button type="submit">Sign</button>
        </form>
        <div class="bg-amber-400 min-w-40 min-h-30">yo</div>
        <div class="bg-cyan-400 min-w-40 min-h-30">yo</div>
        <div class="bg-green-400 min-w-40 min-h-30">yo</div>
        <div class="bg-amber-400 min-w-40 min-h-30">yo</div>
        <div class="bg-blue-400 min-w-40 min-h-30">yo</div>
        <div class="bg-red-400 min-w-40 min-h-30">yo</div>
        <div class="bg-amber-400 min-w-40 min-h-30">yo</div>
        <div class="bg-violet-400 min-w-40 min-h-30">yo</div>
        <div class="bg-pink-400 min-w-40 min-h-30">yo</div>
      </div>
    </main>
  </div>
</Layout>
