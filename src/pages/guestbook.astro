---
import Layout from '@/layouts/main.astro';
import { ChevronLeft, ChevronRight, Send } from 'lucide-react';
---

<Layout>
  <div class="min-h-screen bg-black text-white antialiased font-sans flex flex-col justify-between">
    <main class="w-full mx-auto px-6 py-16 flex-1 text-center">
      <h1 class="text-6xl font-serif tracking-tight mb-3">Guestbook</h1>
      <p class="text-neutral-400 text-sm max-w-md mx-auto font-sans mb-16">
        Feel free to leave any messages or thoughts about my site!
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16 items-start text-left max-w-8xl mx-auto">
        
        <form
          id="guestbookForm"
          class="relative aspect-[530.67/302] w-full min-w-[300px] max-w-[540px] rounded-sm drop-shadow-md bg-cover bg-no-repeat bg-center select-none overflow-hidden text-neutral-700">
          <input type="hidden" name="bg_style" id="bgStyleInput" value="hackclub" />

          <div class="absolute inset-0 p-5 flex flex-col justify-between z-10 font-sans">
            <div class="w-full pt-6 px-12">
              <textarea
                name="message"
                placeholder="Text goes here write whatever your heart desires, or just your thoughts, no pressure."
                rows="3"
                required
                class="w-full bg-transparent outline-none placeholder:text-neutral-500/60 text-sm md:text-[15px] italic font-medium tracking-tight resize-none leading-snug border-none focus:ring-0 p-0">
              </textarea>
            </div>

            <div class="flex justify-between items-end w-full px-12 pb-3">
              
              <div class="flex flex-col gap-1.5 items-start">
                <div
                  class="flex items-center justify-between bg-white text-black text-xs font-semibold px-2.5 py-1 rounded-full shadow-sm border border-neutral-200 w-24 h-7">
                  <button type="button" id="prevStyle" class="hover:opacity-60 transition-opacity font-bold">
                    <ChevronLeft size={14} />
                  </button>
                  <span class="lowercase text-xs tracking-wide select-none font-mono">style</span>
                  <button type="button" id="nextStyle" class="hover:opacity-60 transition-opacity font-bold">
                    <ChevronRight size={14} />
                  </button>
                </div>

                <button
                  type="submit"
                  class="flex items-center justify-center gap-1 bg-white text-black text-xs font-semibold px-3 py-1 rounded-full shadow-sm border border-neutral-200 w-24 h-7 hover:bg-neutral-50 transition-transform active:scale-95 font-okokinstrument-sans]">
                  <span>send</span>
                  <Send size={11} className="translate-x-0.5 -translate-y-0.5 rotate-45" />
                </button>
              </div>

              <div class="flex flex-col items-end gap-0.5 max-w-[180px] text-right font-mono">
                <input
                  type="text"
                  name="name"
                  placeholder="Your beautiful name"
                  required
                  class="w-full bg-transparent outline-none border-none focus:ring-0 p-0 text-right text-sm font-medium placeholder:text-neutral-500/60 text-neutral-800"
                />
                <input
                  type="url"
                  name="website"
                  placeholder="website (opt)"
                  class="w-full bg-transparent outline-none border-none focus:ring-0 p-0 text-right text-[11px] placeholder:text-neutral-500/40 text-neutral-600"
                />
              </div>
            </div>
          </div>
        </form>

        <div id="guestbookEntries" class="contents"></div>
      </div>
    </main>
  </div>
</Layout>

<script>
  const styles = [
    { id: 'hackclub', filename: 'hackclub.png', classes: 'text-neutral-800' },
    { id: 'orange', filename: 'yellow.png', classes: 'text-neutral-900' },
    { id: 'beige', filename: 'plain.png', classes: 'text-neutral-900' },
    { id: 'blue', filename: 'cyan.png', classes: 'text-blue-950' },
    { id: 'pink', filename: 'pink.png', classes: 'text-pink-950' },
    { id: 'checkers', filename: 'washi.png', classes: 'text-neutral-900' },
  ];

  let currentStyleIndex = 0;
  const formElement = document.getElementById('guestbookForm') as HTMLFormElement;
  const bgInput = document.getElementById('bgStyleInput') as HTMLInputElement;
  const entriesContainer = document.getElementById('guestbookEntries')!;

  function updateFormTheme() {
    const active = styles[currentStyleIndex];
    bgInput.value = active.id;

    // Use full coverage layout options so proportions lock nicely on wide screen components
    formElement.className = `relative aspect-[530.67/302] w-full rounded-sm shadow-md transition-all duration-300 bg-cover bg-no-repeat bg-center ${active.classes}`;
    formElement.style.backgroundImage = `url('https://cdn.vejas.zip/assets/postcards/${active.filename}')`;
  }

  document.getElementById('nextStyle')?.addEventListener('click', () => {
    currentStyleIndex = (currentStyleIndex + 1) % styles.length;
    updateFormTheme();
  });

  document.getElementById('prevStyle')?.addEventListener('click', () => {
    currentStyleIndex = (currentStyleIndex - 1 + styles.length) % styles.length;
    updateFormTheme();
  });

  async function loadEntries() {
    try {
      const res = await fetch('/api/guestbook');
      if (!res.ok) throw new Error();
      
      // Match the native database column mappings returned by D1 (style, link)
      const records = (await res.json()) as Array<{
        name: string;
        message: string;
        style: string;
        link?: string;
        created_at: string;
      }>;

      entriesContainer.innerHTML = records
        .map((entry) => {
          const matchingStyle = styles.find((s) => s.id === entry.style) || styles[0];
          const cdnUrl = `https://cdn.vejas.zip/assets/postcards/${matchingStyle.filename}`;

          const dateString = new Date(entry.created_at).toLocaleDateString('en-US', {
            month: 'short',
            day: 'numeric',
          });

          const nameLabel = entry.link
            ? `<a href="${entry.link}" target="_blank" class="hover:underline font-semibold">${entry.name}</a>`
            : `<span>${entry.name}</span>`;

          return `
          <div class="relative aspect-[530.67/302] w-full rounded-sm shadow-md bg-cover bg-no-repeat bg-center overflow-hidden ${matchingStyle.classes}" 
               style="background-image: url('${cdnUrl}')">
            
            <div class="absolute inset-0 p-5 flex flex-col justify-between font-sans">
              <div class="w-full pt-6 px-12">
                <p class="leading-snug tracking-tight break-words text-sm md:text-[15px] italic font-medium text-current">
                  ${entry.message}
                </p>
              </div>

              <div class="flex justify-between items-end w-full px-12 pb-4 font-mono">
                <div class="text-[10px] opacity-40 font-semibold tracking-wider bg-white/20 backdrop-blur-xs px-2 py-0.5 rounded-full text-black">
                  ${dateString}
                </div>
                <div class="flex flex-col items-end gap-0.5 max-w-[180px] text-right text-current">
                  <span class="text-sm font-semibold tracking-tight">${nameLabel}</span>
                  <span class="text-[10px] opacity-50 tracking-tighter">visitor</span>
                </div>
              </div>
            </div>
          </div>
        `;
        })
        .join('');
    } catch (err) {
      entriesContainer.innerHTML = `<p class="text-xs text-red-400 font-sans p-4">Could not parse guestbook log feed.</p>`;
    }
  }

  formElement.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(formElement);
    const bodyPayload = Object.fromEntries(formData.entries());

    try {
      const res = await fetch('/api/guestbook', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(bodyPayload),
      });

      if (res.ok) {
        formElement.reset();
        currentStyleIndex = 0;
        updateFormTheme();
        loadEntries();
      }
    } catch (err) {
      console.error('Submission failed');
    }
  });

  updateFormTheme();
  loadEntries();
</script>