---
import Layout from "@/layouts/main.astro"
import { Button } from "@/components/ui/button"
import { ArrowUpRight } from "lucide-react"
import { Image } from "astro:assets"
import { getCollection } from "astro:content"
import { userData } from "@/lib/user-data"

const allProjects = await getCollection("projects")

const latestProjects = allProjects
  .filter((p) => p.data.date)
  .sort((a, b) => new Date(b.data.date!).getTime() - new Date(a.data.date!).getTime())
  .slice(0, 2)

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
)
---

<Layout>
  <!-- HERO -->
  <div
    class="flex flex-col w-full p-6 pt-32 pb-48 items-center justify-start text-center gap-6"
  >
    <img
      src={userData.cdn.assets.heroDark}
      alt="Hero illustration"
      aria-label="Vejas S"
      class="w-full max-w-4xl hidden dark:block"
    />
    <img
      src={userData.cdn.assets.heroLight}
      alt="Hero illustration"
      aria-label="Vejas S"
      class="w-full max-w-4xl dark:hidden"
    />

    <h2 class="text-3xl font-serif max-w-xl balance">
      is a teen dev based in Luxembourg, who loves to tinker with hardware and
      create polished websites.
    </h2>
  </div>

  <!-- MAIN GRID -->
  <div class="grid grid-cols-1 lg:grid-cols-2 w-full border-t border-border/40 items-start mb-32">

    <!-- PROJECTS -->
    <div class="flex items-center flex-col justify-center p-12 border-r px-24 border-border/40">
      <h1 class="text-7xl font-serif pb-12">Projects</h1>

      <div class="pb-6">
        {latestProjects.map(({ id, data }, i) => (
          <div class={`flex items-start gap-4 pb-10 ${i % 2 === 1 ? "flex-row-reverse" : ""}`}>
            {data.image && (
              <Image
                src={data.image}
                alt={`Image of ${data.title}`}
                class="w-2/5 h-auto rounded-2xl object-cover shrink-0"
              />
            )}

            <div class="flex flex-col gap-2">
              <h2 class="text-3xl font-serif">{data.title}</h2>

              <p class="text-sm text-muted-foreground">
                {data.description}
              </p>

              <div class="flex gap-2">
                <a href={`/projects/${id}`}>
                  <Button variant="default" size="sm">
                    <ArrowUpRight /> Read more
                  </Button>
                </a>

                {data.github && (
                  <a href={data.github} target="_blank">
                    <Button variant="outline" size="sm">
                      <img src={userData.cdn.assets.githubIcon} alt="" class="size-4 dark-mode-icon" />
                      Repository
                    </Button>
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

      <a href="/projects">
        <Button variant="outline" size="lg">
          <ArrowUpRight /> Projects Page
        </Button>
      </a>
    </div>

    <div class="flex items-center flex-col justify-center p-12">
    <h1 class="text-7xl font-serif pb-12">Blog</h1>

    {posts.length === 0 ? (
      <p class="text-xs text-muted-foreground text-center pt-2">
        Posts coming soon!
      </p>
    ) : (
      <ul class="flex flex-col gap-8 w-full max-w-2xl">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="group block">
              <h2 class="text-2xl font-serif group-hover:text-muted-foreground transition-colors">
                {post.data.title}
              </h2>
              {post.data.description && (
                <p class="text-sm text-muted-foreground mt-1">
                  {post.data.description}
                </p>
              )}
              <p class="text-xs text-muted-foreground/70 mt-2">
                {new Date(post.data.date).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>

  </div>
</Layout>

<style>
  :global(.dark) .dark-mode-icon {
    filter: invert(1) brightness(2);
  }
</style>