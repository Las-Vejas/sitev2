---
import Layout from "@/layouts/main.astro"
import { Button } from "@/components/ui/button"
---

<Layout>
    <div class="flex flex-col items-center justify-center text-center pt-32 pb-20 px-6">
        <h1 class="text-8xl font-serif mb-4">About Me</h1>
        <div class="grid grid-cols-3 gap-8 w-full">
            <div class="col-span-1 flex flex-col gap-4 border border-border rounded-2xl p-8 bg-accent/5">
                <h2 class="text-3xl font-semibold">Who am I?</h2>
                <p class="text-sm leading-relaxed text-muted-foreground">My name is Vejas (as you may know) and I am a 16 year old developer based in Luxembourg. I enjoy making website and tinkering with hardware.</p>
            </div>
            <div class="col-span-2">
                <h2 class="text-3xl">My Tech Stack</h2>
                <div class="flex gap-4 mt-4 justify-center flex-wrap">
                    <div class="border border-border rounded-2xl p-6 flex flex-col items-center bg-accent/5 hover:bg-accent/10 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 85 107" class="w-8 h-8 mb-2"><path class="fill-[#17191E] dark:fill-white" d="M27.59 91.136c-4.834-4.418-6.246-13.703-4.232-20.429 3.492 4.241 8.33 5.584 13.342 6.343 7.737 1.17 15.336.732 22.523-2.804.822-.405 1.582-.943 2.48-1.489.675 1.957.85 3.932.615 5.943-.573 4.896-3.01 8.678-6.885 11.545-1.55 1.147-3.19 2.172-4.79 3.253-4.917 3.323-6.247 7.22-4.4 12.888.044.139.084.277.183.614-2.51-1.124-4.344-2.76-5.742-4.911-1.475-2.27-2.177-4.78-2.214-7.498-.019-1.322-.019-2.656-.197-3.96-.434-3.178-1.926-4.601-4.737-4.683-2.884-.084-5.166 1.699-5.771 4.507-.046.216-.113.429-.18.68l.004.001ZM0 69.587s14.314-6.973 28.668-6.973L39.49 29.12c.405-1.62 1.588-2.72 2.924-2.72 1.335 0 2.518 1.1 2.924 2.72L56.16 62.614c17 0 28.668 6.973 28.668 6.973S60.514 3.352 60.467 3.219C59.769 1.261 58.591 0 57.003 0H27.827c-1.588 0-2.718 1.261-3.464 3.22C24.311 3.35 0 69.586 0 69.586Z"/></svg>
                        <h3 class="font-semibold">Astro</h3>
                    </div>
                    <div class="border border-border rounded-2xl p-6 flex flex-col items-center bg-accent/5 hover:bg-accent/10 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 54 33" class="w-8 h-8 mb-2"><g clip-path="url(#tailwindcss-a)"><path fill="#38bdf8" fill-rule="evenodd" d="M27 0c-7.2 0-11.7 3.6-13.5 10.8 2.7-3.6 5.85-4.95 9.45-4.05 2.054.513 3.522 2.004 5.147 3.653C30.744 13.09 33.808 16.2 40.5 16.2c7.2 0 11.7-3.6 13.5-10.8-2.7 3.6-5.85 4.95-9.45 4.05-2.054-.513-3.522-2.004-5.147-3.653C36.756 3.11 33.692 0 27 0zM13.5 16.2C6.3 16.2 1.8 19.8 0 27c2.7-3.6 5.85-4.95 9.45-4.05 2.054.514 3.522 2.004 5.147 3.653C17.244 29.29 20.308 32.4 27 32.4c7.2 0 11.7-3.6 13.5-10.8-2.7 3.6-5.85 4.95-9.45 4.05-2.054-.513-3.522-2.004-5.147-3.653C23.256 19.31 20.192 16.2 13.5 16.2z" clip-rule="evenodd"/></g><defs><clipPath id="tailwindcss-a"><path fill="#fff" d="M0 0h54v32.4H0z"/></clipPath></defs></svg>
                        <h3 class="font-semibold">Tailwind CSS</h3>
                    </div>
                    <div class="border border-border rounded-2xl p-6 flex flex-col items-center bg-accent/5 hover:bg-accent/10 transition-colors">
                        <svg viewBox="0 0 256 222" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid" class="w-8 h-8 mb-2"><path class="fill-black dark:fill-white" d="m128 0 128 221.705H0z"/></svg>
                        <h3 class="font-semibold">Vercel</h3>
                    </div>
                    <div class="border border-border rounded-2xl p-6 flex flex-col items-center bg-accent/5 hover:bg-accent/10 transition-colors">
                        <svg fill="none" viewBox="0 0 201 170" xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 mb-2"><path class="fill-[#183134] dark:fill-white" d="m200.035 48.61c-4.67-27.94-29.16-48.61-29.16-48.61v30.78l-14.54 3.75-9.11-10.97-4.81 9.46c-9.92-2.7-23.58-4.44-42.37-4.44-18.7901 0-32.4501 1.75-42.3701 4.44l-4.81-9.46-9.11 10.97-14.54-3.75v-30.78s-24.48997 20.67-29.1599684 48.61l32.1399684 11.12c1.05 19.43 9.79 71.88 12.29 76.64 2.66 5.07 16.78 19.56 27.83 25.13 0 0 4-4.23 6.44-7.96 3.1 3.65 19.11 16.45 21.3001 16.45 2.19 0 18.2-12.79 21.3-16.45 2.44 3.73 6.44 7.96 6.44 7.96 11.05-5.57 25.17-20.06 27.83-25.13 2.5-4.76 11.24-57.21 12.29-76.64l32.14-11.12zm-46.19 44.74-21.75 1.94 1.91 26.67s-13.23 10.95-33.96 10.95c-20.7301 0-33.9601-10.95-33.9601-10.95l1.91-26.67-21.75-1.94-3.72-30.04 36.05 12.48-2.8 37.39c6.7 1.7 13.75 3.39 24.2801 3.39 10.53 0 17.57-1.69 24.27-3.39l-2.8-37.39 36.05-12.48-3.72 30.04z"/></svg>
                        <h3 class="font-semibold">Frontend</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>