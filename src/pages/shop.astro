---
import Layout from '@/layouts/main.astro';

export const prerender = true;

interface Product {
  slug: string
  title: string
  description: string
  price: number
  currency: string
  tags: string[]
  kofiUrl: string
  image?: string
}

const products: Product[] = [
  {
    slug: "cs-9618-anki",
    title: "Cambridge A Level Computer Science 9618 Anki Deck",
    description:
      "700 flashcards made from the 9618 syllabus and textbook, organised into chapters. Includes a set of definitions (key terms) and a set of cloze flashcards.",
    price: 2,
    currency: "EUR",
    tags: ["Anki", "A Level 9618"],
    kofiUrl: "https://ko-fi.com/s/9413bbe753",
    image:
      "https://storage.ko-fi.com/cdn/useruploads/display/f3d24250-76a9-467d-bd6c-c7da9d9974d3_gemini_generated_image_d57fq9d57fq9d57f.jpeg",
  },
  {
    slug: "igcse-physics-0625-anki",
    title: "Cambridge IGCSE Physics 0625 Anki Deck",
    description:
      "170 flashcards made from the 0625 syllabus, organised into chapters. Includes a set of definitions (key terms) and a set of cloze flashcards.",
    price: 1,
    currency: "EUR",
    tags: ["Anki", "IGCSE 0625"],
    kofiUrl: "https://ko-fi.com/s/d99f358caf",
    image:
      "https://storage.ko-fi.com/cdn/useruploads/display/18fc40b3-be46-4347-b76c-88b35517be1d_anki-icon.svg.png",
  },
  {
    slug: "igcse-economics-0455-anki",
    title: "Cambridge IGCSE Economics 0455 Anki Deck",
    description:
      "171 flashcards made from the 0455 syllabus, organised into chapters. Includes a set of cloze flashcards and a set of definitions.",
    price: 1,
    currency: "EUR",
    tags: ["Anki", "IGCSE 0455"],
    kofiUrl: "https://ko-fi.com/s/465f400058",
    image:
      "https://storage.ko-fi.com/cdn/useruploads/display/68edc207-67f9-4503-91c5-0662c7c2da34_anki-icon.svg.png",
  },
  {
    slug: "igcse-biology-0610-anki",
    title: "Cambridge IGCSE Biology 0610 Anki Deck",
    description:
      "609 flashcards made from the 0610 syllabus, organised into chapters so you can study one topic at a time.",
    price: 1,
    currency: "EUR",
    tags: ["Anki", "IGCSE 0610"],
    kofiUrl: "https://ko-fi.com/s/0579da2fa7",
    image:
      "https://storage.ko-fi.com/cdn/useruploads/display/65654814-81dd-4582-a6c3-ea43edd84d93_anki-icon.svg.png",
  },
  {
    slug: "igcse-cs-0478-anki",
    title: "Cambridge IGCSE Computer Science 0478 Anki Deck",
    description:
      "273 flashcards made from the 0478 syllabus, organised into chapters so you can study one topic at a time.",
    price: 1,
    currency: "EUR",
    tags: ["Anki", "IGCSE 0478"],
    kofiUrl: "https://ko-fi.com/s/1ad9ff7072",
    image:
      "https://storage.ko-fi.com/cdn/useruploads/display/9c53aaaa-73dd-4560-beb9-288e1e254272_anki-icon.svg.png",
  },
  {
    slug: "igcse-chemistry-0620-anki",
    title: "Cambridge IGCSE Chemistry 0620 Anki Deck",
    description:
      "440 flashcards made from the 0620 syllabus, covering the whole course.",
    price: 1,
    currency: "EUR",
    tags: ["Anki", "IGCSE 0620"],
    kofiUrl: "https://ko-fi.com/s/56a0f9c957",
    image:
      "https://storage.ko-fi.com/cdn/useruploads/display/f8e3fcde-c92e-4e6b-a563-3bc75749c8df_anki-icon.svg.png",
  },
]

const siteURL = Astro.site ?? "https://vejas.zip"
const pageURL = new URL(Astro.url.pathname, siteURL).toString()

const formatPrice = (price: number, currency: string) =>
  new Intl.NumberFormat("en", { style: "currency", currency }).format(price)

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": products.map((p) => ({
    "@type": "Product",
    "@id": `${pageURL}#${p.slug}`,
    name: p.title,
    description: p.description,
    ...(p.image && { image: new URL(p.image, siteURL).toString() }),
    brand: { "@type": "Brand", name: "vejas.zip" },
    offers: {
      "@type": "Offer",
      url: p.kofiUrl,
      price: p.price.toFixed(2),
      priceCurrency: p.currency,
      availability: "https://schema.org/InStock",
    },
  })),
}

// Escape "<" so product text can never close the script tag early
const jsonLdString = JSON.stringify(jsonLd).replace(/</g, "\\u003c")
---

<Layout
  title="Cambridge IGCSE & A Level Anki Decks"
  description="Anki flashcard decks for Cambridge IGCSE Physics 0625, Chemistry 0620, Biology 0610, Economics 0455, Computer Science 0478 and A Level Computer Science 9618."
  image={products[0].image}
>
  <script is:inline slot="head" type="application/ld+json" set:html={jsonLdString} />

  <div class="flex flex-col items-center justify-center text-center pt-32 pb-20 px-6 gap-y-4">
    <h1 class="text-8xl font-serif">Shop</h1>
    <p class="text-muted-foreground text-sm">Things I've made that might help you too.</p>
  </div>

  <section class="mx-auto w-full max-w-6xl px-6 pb-24">
    <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((p) => (
        <li
          id={p.slug}
          class="group flex flex-col overflow-hidden rounded-xl border border-border bg-card text-card-foreground transition-colors hover:border-foreground/20"
        >
          <div class="aspect-4/3 w-full overflow-hidden border-b border-border bg-muted">
            {p.image ? (
              <img
                src={p.image}
                alt={p.title}
                loading="lazy"
                class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-105"
              />
            ) : (
              <div class="flex h-full w-full items-center justify-center">
                <span class="font-serif text-5xl text-muted-foreground/60">{p.tags[0]}</span>
              </div>
            )}
          </div>

          <div class="flex flex-1 flex-col gap-4 p-5">
            <div class="flex flex-wrap gap-2">
              {p.tags.map((tag) => (
                <span class="rounded-full border border-border bg-secondary px-2.5 py-0.5 text-xs font-medium text-secondary-foreground">
                  {tag}
                </span>
              ))}
            </div>

            <div class="flex flex-col gap-1.5">
              <h2 class="text-lg font-semibold leading-snug">{p.title}</h2>
              <p class="text-sm text-muted-foreground">{p.description}</p>
            </div>

            <div class="mt-auto flex items-center justify-between gap-4 pt-2">
              <span class="font-serif text-3xl">{formatPrice(p.price, p.currency)}</span>
              <a
                href={p.kofiUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-85 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
              >
                Buy on Ko-fi
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
                  <path d="M7 17 17 7" /><path d="M7 7h10v10" />
                </svg>
              </a>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Layout>
