---
import Layout from '@/layouts/main.astro';
---

<Layout>
  <div class="flex flex-col items-center justify-center text-center pt-32 pb-20 px-6 gap-y-4">
    <h1 class="text-8xl font-serif">Webrings & buttons</h1>
    <p class="text-muted-foreground text-sm">My friends from the internet!</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 w-full max-w-6xl">
      <div class="flex flex-col items-center gap-6 mt-8">
        <h2 class="font-serif text-6xl">Pagerings</h2>
        <pagering-link theme="auto" class="flex items-center justify-center m-auto"></pagering-link>
      </div>

      <div class="flex flex-col items-center gap-6 mt-8">
        <h2 class="font-serif text-6xl">Buttons</h2>
        <p class="text-muted-foreground text-sm">My collection of 88x31 buttons!</p>
        <div>
          <p class="text-sm text-foreground-muted">copy my buttons!</p>
          <div class="flex mt-4 gap-2">
            <button type="button" class="copy-button-img" data-url="https://cdn.vejas.zip/vejas-light.png">
              <img
                src="https://cdn.vejas.zip/vejas-light.png"
                alt="Vejas button (light)"
                width="88"
                height="31"
                class="border border-border/40 cursor-pointer"
              />
            </button>
            <button type="button" class="copy-button-img" data-url="https://cdn.vejas.zip/vejas-dark.png">
              <img
                src="https://cdn.vejas.zip/vejas-dark.png"
                alt="Vejas button (dark)"
                width="88"
                height="31"
                class="border border-border/40 cursor-pointer"
              />
            </button>
          </div>
          <p id="copyFeedback" class="text-xs text-muted-foreground mt-2 opacity-0 transition-opacity">Copied!</p>
        </div>
        <div class="flex flex-wrap gap-3 justify-center p-6">
          <a href="https://gideon.sh" target="_blank" rel="noopener noreferrer">
            <img
              src="https://gideon.sh/88x31.gif"
              width="88"
              height="31"
              alt="Gideon's site button"
              class="border border-border/40"
              loading="lazy"
            />
          </a>

          <a href="https://88x31.nl" target="_blank" rel="noopener noreferrer">
            <img
              src="https://88x31.nl/gifs/chrome.gif"
              width="88"
              height="31"
              alt="Chrome button"
              class="border border-border/40"
              loading="lazy"
            />
          </a>

          <img
            src="https://cyber.dabamos.de/88x31/construction.gif"
            width="88"
            height="31"
            alt="Under construction button"
            class="border border-border/40"
            loading="lazy"
          />

          <a href="https://gizzy.gay" target="_blank" rel="noopener noreferrer">
            <img
              src="https://gizzy.gay/88x31.svg"
              width="88"
              height="31"
              alt="Gizzy's site button"
              class="border border-border/40"
              loading="lazy"
            />
          </a>

          <img
            src="https://anlucas.neocities.org/apple.gif"
            width="88"
            height="31"
            alt="Apple button"
            class="border border-border/40"
            loading="lazy"
          />

          <img
            src="https://anlucas.neocities.org/macmade-wht.gif"
            width="88"
            height="31"
            alt="Made on Mac button"
            class="border border-border/40"
            loading="lazy"
          />

          <img
            src="https://inkedpetal.dev/88x31/18.png"
            width="88"
            height="31"
            alt="Inked Petal button"
            class="border border-border/40"
            loading="lazy"
          />

          <a href="https://www.valen.zip" target="_blank" rel="noopener noreferrer">
            <img
              src="https://www.valen.zip/button-win98.gif"
              width="88"
              height="31"
              alt="Valen's site's Windows 98 themed button"
              class="border border-border/40"
              loading="lazy"
            />
          </a>

          <img
            src="https://cdn.vejas.zip/assets/buttons/github.gif"
            width="88"
            height="31"
            alt="GitHub button"
            class="border border-border/40"
            loading="lazy"
          />

          <img
            src="https://cdn.vejas.zip/assets/buttons/notai.png"
            width="88"
            height="31"
            alt="Not made by AI button"
            class="border border-border/40"
            loading="lazy"
          />

          <img
            src="https://cdn.vejas.zip/assets/buttons/homeass.gif"
            width="88"
            height="31"
            alt="Home Assistant button"
            class="border border-border/40"
            loading="lazy"
          />

          <img
            src="https://cdn.vejas.zip/assets/buttons/hackclub.gif"
            width="88"
            height="31"
            alt="Hack Club button"
            class="border border-border/40"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</Layout>
<script src="https://pagering.gideon.sh/embed.js" defer></script>

<script>
    const feedback = document.getElementById("copyFeedback")
    let feedbackTimeout: ReturnType<typeof setTimeout>

    document.querySelectorAll<HTMLButtonElement>('.copy-button-img').forEach((btn) =>{
        btn.addEventListener("click", async ()=> {
            const url = btn.dataset.url
            if (!url) return

            try {
                await navigator.clipboard.writeText(url)
                if (feedback) {
                    feedback.textContent = 'Copied!'
                    feedback.classList.remove("opacity-0")
                    clearTimeout(feedbackTimeout)
                    feedbackTimeout = setTimeout(() =>
                        feedback.classList.add("opacity-0"), 1300);
                }
            } catch (err) {
                console.error("copy failed: ", err)
                if (feedback) {
          feedback.textContent = "Couldn't copy — try manually."
          feedback.classList.remove("opacity-0")
          clearTimeout(feedbackTimeout)
          feedbackTimeout = setTimeout(() => feedback.classList.add("opacity-0"), 2000)
        }
            }
            
        })
    }
    )
</script>